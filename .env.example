# Copy to .env and fill in. .env is gitignored and must never be committed.

# HTTP port the API listens on.
PORT=8080

# MongoDB connection string and database name.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=evernote_lite

# HS256 signing key for access tokens. REQUIRED — the service refuses to start
# without it. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Access token lifetime. api_spec.md suggests roughly one hour.
JWT_EXPIRY=1h

# bcrypt cost. api_spec.md sets the floor at 10; the service rejects anything lower.
BCRYPT_COST=12

# Public base URL, used to build the share links returned by the share endpoint.
APP_BASE_URL=http://localhost:8080

# Comma-separated list of origins the CORS middleware permits, or "*" for any.
# Safe as "*" here because auth is a bearer token, not a cookie.
CORS_ALLOWED_ORIGINS=*

# Requests allowed per caller, per window, on the auth and public share
# endpoints — the two api_spec.md's security notes call out by name.
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=1m
